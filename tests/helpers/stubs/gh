#!/usr/bin/env bash
# Fake `gh` for offline tests. Shadows the real gh via a PATH-stub dir.
#
# Emulates the subset of `gh` that the helper scripts call. For any subcommand
# that takes a `-q`/`--jq` query, the query is applied with jq to the matching
# fixture under tests/fixtures/ — exactly as real gh would apply it server-side.
# With no query, the raw fixture JSON is printed.
#
# Env knobs:
#   GH_STUB_EXIT      if non-empty, exit immediately with this code (simulate any
#                     failure — e.g. `gh auth status` unauthenticated). Honored
#                     for every invocation.
#   GH_STUB_REPO_FAIL if non-empty, `gh repo view` exits 1 (simulate not-a-repo)
#                     while `gh auth status` still succeeds.
set -euo pipefail

# Global failure override (covers unauthenticated `auth status` and the
# "an env var makes it exit non-zero" acceptance).
if [[ -n "${GH_STUB_EXIT:-}" ]]; then
    exit "$GH_STUB_EXIT"
fi

STUB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIX="$STUB_DIR/../../fixtures"

# Pull the jq query out of `-q <expr>` or `--jq <expr>`, if present.
query=""
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in
        -q | --jq)
            j=$((i + 1))
            query="${!j:-}"
            ;;
    esac
done

emit() { # emit <fixture-file>
    if [[ -n "$query" ]]; then
        jq -r "$query" "$FIX/$1"
    else
        cat "$FIX/$1"
    fi
}

cmd="${1:-}"
sub="${2:-}"

case "$cmd $sub" in
    "auth status") exit 0 ;;
    "repo view")
        [[ -n "${GH_STUB_REPO_FAIL:-}" ]] && exit 1
        emit repo.json
        ;;
    "repo list") emit repos.json ;;
    "issue list") emit issues.json ;;
    "pr list") emit prs.json ;;
    "pr view")
        num="${3:-}"
        obj="$(jq -c ".[] | select(.number == ${num})" "$FIX/prs.json")"
        if [[ -n "$query" ]]; then
            printf '%s' "$obj" | jq -r "$query"
        else
            printf '%s\n' "$obj"
        fi
        ;;
    "release list") emit releases.json ;;
    "run list") emit runs.json ;;
    "run view") exit 0 ;;
    *) exit 0 ;;
esac
