#!/usr/bin/env bash
# Fake `gh` for offline tests. Shadows the real gh via a PATH-stub dir.
#
# Emulates the subset of `gh` that the helper scripts call. For any subcommand
# that takes a `-q`/`--jq` query, the query is applied with jq to the matching
# fixture under tests/fixtures/ — exactly as real gh would apply it server-side.
# With no query, the raw fixture JSON is printed.
#
# Env knobs:
#   GH_STUB_EXIT      if non-empty, exit immediately with this code (simulate any
#                     failure — e.g. `gh auth status` unauthenticated). Honored
#                     for every invocation.
#   GH_STUB_REPO_FAIL    if non-empty, `gh repo view` exits 1 (simulate not-a-repo)
#                        while `gh auth status` still succeeds.
#   GH_STUB_NO_PRS       if non-empty, `pr list` returns an empty array.
#   GH_STUB_NO_RELEASES  if non-empty, `release list` returns an empty array.
#   GH_STUB_NO_DEP_PRS   if non-empty, `pr list` returns PRs with no dep matches.
set -euo pipefail

# Global failure override (covers unauthenticated `auth status` and the
# "an env var makes it exit non-zero" acceptance).
if [[ -n "${GH_STUB_EXIT:-}" ]]; then
    exit "$GH_STUB_EXIT"
fi

STUB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIX="$STUB_DIR/../../fixtures"

# Pull the jq query out of `-q <expr>` or `--jq <expr>`, if present.
query=""
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in
        -q | --jq)
            j=$((i + 1))
            query="${!j:-}"
            ;;
    esac
done

emit() { # emit <fixture-file>
    if [[ -n "$query" ]]; then
        jq -r "$query" "$FIX/$1"
    else
        cat "$FIX/$1"
    fi
}

cmd="${1:-}"
sub="${2:-}"

case "$cmd $sub" in
    "auth status") exit 0 ;;
    "repo view")
        [[ -n "${GH_STUB_REPO_FAIL:-}" ]] && exit 1
        emit repo.json
        ;;
    "repo list") emit repos.json ;;
    "issue list") emit issues.json ;;
    "pr list")
        if [[ -n "${GH_STUB_NO_PRS:-}" ]]; then
            emit prs-empty.json
        elif [[ -n "${GH_STUB_NO_DEP_PRS:-}" ]]; then
            emit prs-no-deps.json
        else
            emit prs.json
        fi
        ;;
    "pr view")
        num="${3:-}"
        if [[ ! "$num" =~ ^[0-9]+$ ]]; then
            echo "gh stub: pr view requires an integer PR number, got: '$num'" >&2
            exit 1
        fi
        obj="$(jq -c --argjson num "$num" '.[] | select(.number == $num)' "$FIX/prs.json")"
        if [[ -n "$query" ]]; then
            printf '%s' "$obj" | jq -r "$query"
        else
            printf '%s\n' "$obj"
        fi
        ;;
    "release list")
        if [[ -n "${GH_STUB_NO_RELEASES:-}" ]]; then
            # Return empty JSON array; jq queries on [] yield nothing for
            # .[] iterations and null for .[0].tagName — suppress null.
            if [[ -n "$query" ]]; then
                result="$(jq -r "$query" "$FIX/releases-empty.json")"
                [[ -n "$result" && "$result" != "null" ]] && printf '%s\n' "$result"
            fi
        else
            emit releases.json
        fi
        ;;
    "run list")
        # When GH_STUB_BRANCH_FAIL is set, emit failure runs for non-master branches.
        if [[ -n "${GH_STUB_BRANCH_FAIL:-}" ]]; then
            branch_arg=""
            for ((i = 1; i <= $#; i++)); do
                if [[ "${!i}" == "--branch" ]]; then
                    j=$((i + 1))
                    branch_arg="${!j:-}"
                fi
            done
            if [[ "$branch_arg" != "master" && -n "$branch_arg" ]]; then
                emit runs-branch-fail.json
            else
                emit runs.json
            fi
        else
            emit runs.json
        fi
        ;;
    "run view") exit 0 ;;
    *)
        echo "gh stub: unsupported invocation: $*" >&2
        exit 1
        ;;
esac
